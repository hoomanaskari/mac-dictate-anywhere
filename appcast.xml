        <item>
            <title>2.12.21</title>
            <pubDate>Mon, 16 Nov 2026 10:25:14 -0500</pubDate>
            <link>https://github.com/hoomanaskari/mac-dictate-anywhere</link>
            <sparkle:version>63</sparkle:version>
