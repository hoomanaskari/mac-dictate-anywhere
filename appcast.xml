        <item>
            <title>2.12.18</title>
            <pubDate>Sun, 25 Oct 2026 15:30:56 -0400</pubDate>
            <link>https://github.com/hoomanaskari/mac-dictate-anywhere</link>
            <sparkle:version>60</sparkle:version>
